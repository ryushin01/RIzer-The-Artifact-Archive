{
  "name": "@rizer/web",
  "version": "0.5.2",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "pnpm run build-storybook && next build",
    "start": "next start --port 3001",
    "lint": "eslint && steiger src",
    "typecheck": "next typegen && tsc7 --noEmit",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:storybook": "vitest run --project storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o public/storybook --quiet",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "@rizer/config": "workspace:*",
    "@rizer/domain": "workspace:*",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "next": "16.4.5",
    "openseadragon": "^6.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "^9.3.1",
    "redux-saga": "^1.5.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/nextjs-vite": "10.6.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@types/openseadragon": "^6.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^30.1.3",
    "redux-saga-test-plan": "^4.0.6",
    "steiger": "0.9.0",
    "storybook": "10.6.6",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}

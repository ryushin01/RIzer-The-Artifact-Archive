# 개발용 값. 운영 값은 Vercel 환경 변수에 둔다(.env.example 참고).
# 어드민(apps/admin)의 공개 API. 서버(캐시)와 브라우저(검색)에서 읽는다.
ARCHIVE_API_URL=http://localhost:3000
NEXT_PUBLIC_ARCHIVE_API_URL=http://localhost:3000
# 어드민이 캐시를 비우라고 알릴 때 쓰는 비밀값(어드민과 같아야 한다)
REVALIDATE_SECRET=dev-revalidate-secret
SITE_URL=http://localhost:3001

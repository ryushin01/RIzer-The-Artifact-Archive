{
  "ci": {
    "collect": {
      "startServerCommand": "sh scripts/lighthouse-servers.sh",
      "startServerReadyPattern": "lighthouse servers ready",
      "url": [
        "http://localhost:3181/",
        "http://localhost:3181/artifacts",
        "http://localhost:3181/artifacts/excalibur",
        "http://localhost:3181/en"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      },
      "startServerReadyTimeout": 120000
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}

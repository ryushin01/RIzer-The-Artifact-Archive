# ── 운영(Vercel) 환경 변수 ──
# DB: 비우면 PGlite(.data/pglite)를 쓴다.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# 로그인
NEXTAUTH_URL=https://admin.example.com
NEXTAUTH_SECRET=
# 운영에서 시드(전설 유물 16점·계정)를 넣을지. 포트폴리오 데모는 1
SEED_DEMO=1
# 큐레이터(쓰기 권한) 계정 비밀번호. 비우면 운영에서는 큐레이터 계정을 만들지 않는다.
CURATOR_PASSWORD=
# 스토리지: local | s3 (Cloudflare R2) | blob (Vercel Blob, BLOB_READ_WRITE_TOKEN은 스토어 연결 시 자동)
STORAGE_DRIVER=blob
# 시드 타일(tiles/…)을 내보내는 곳. 기본은 WEB_URL(공개 사이트의 정적 파일)
STATIC_TILES_URL=
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=rizer
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 타일을 내보내는 공개 주소(R2 공개 도메인)
STORAGE_PUBLIC_URL=https://tiles.example.com
# 공개 사이트 캐시 비우기
WEB_REVALIDATE_URL=https://www.example.com/api/revalidate
REVALIDATE_SECRET=

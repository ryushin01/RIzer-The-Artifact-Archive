# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
test-results/
playwright-report/
playwright/.cache/

# turborepo
.turbo/


# IDE 설정
.idea/
!.env.example
!.env.development

# PGlite 개발 DB (pnpm --filter @rizer/admin db:reset으로 지우고 다시 만든다)
.data/

# Playwright 로그인 상태 (e2e/auth.setup.ts가 매번 만든다)
apps/*/e2e/.auth/

# Storybook 빌드 결과
storybook-static/
# 빌드할 때 만드는 Storybook (공개 사이트와 함께 /storybook에 배포)
**/public/storybook/

# 로컬 스토리지(원본 이미지·딥줌 타일). pnpm seed:images로 다시 만든다.
apps/admin/.data/

